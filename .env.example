# ============================================================
# Browser-safe values (Vite inlines these into the client bundle)
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ============================================================
# Server-only edge-function secrets
# Set these in Project Settings -> Secrets (Supabase Edge Function
# secrets). Never commit real values. Never expose these to the browser.
# ============================================================

# --- Feature flags (must agree with src/lib/constants.ts) ---
# VIP checkout is off unless Stripe is fully configured AND the frontend
# flag VIP_SALES_ENABLED in src/lib/constants.ts is also true.
VIP_SALES_ENABLED=false
# SMS is off unless Twilio + consent + STOP handling are verified.
SMS_ENABLED=false

# --- App / routing ---
APP_URL=https://appreneur.ai

# --- Analytics rate limiting (REQUIRED before public traffic) ---
# track-funnel-event fails closed without this. Placeholder only; the
# real value is generated with openssl rand -hex 32 and stored ONLY as
# an edge secret. Never paste the real value into this file.
FUNNEL_RATE_LIMIT_SECRET=replace-me-with-a-random-32-byte-hex-string

# --- Transactional email (Resend) ---
RESEND_API_KEY=re_replace_me
FROM_EMAIL=hello@appreneur.ai
REPLY_TO_EMAIL=support@appreneur.ai

# --- Payments (Stripe) — only needed if VIP_SALES_ENABLED=true ---
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- SMS (Twilio) — only needed if SMS_ENABLED=true ---
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...
